# Copy this file to .env and fill in real values. Never commit .env.

# OpenAI, or a NVIDIA NIM key if OPENAI_BASE_URL points at NIM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Uncomment for NVIDIA NIM. Use the model id from build.nvidia.com.
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_MODEL=

TAVILY_API_KEY=
GCP_PROJECT_ID=

# Leave these unset on your laptop. deploy.sh and the Docker image set them.
# NOTES_DIR=/app/notes
# SQLITE_PATH=/app/data/research.db
# MCP_SERVERS_CONFIG=/app/mcp_config.json
