# Copy this file to .env and fill in real values. Never commit .env.

# NVIDIA NIM. The key stays in .env, which is gitignored.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional OpenAI fallback. Used only when NVIDIA_API_KEY is unset.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=

TAVILY_API_KEY=
GCP_PROJECT_ID=

# Leave these unset on your laptop. deploy.sh and the Docker image set them.
# NOTES_DIR=/app/notes
# SQLITE_PATH=/app/data/research.db
# MCP_SERVERS_CONFIG=/app/mcp_config.json
